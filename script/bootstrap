#!/bin/sh

set -eu

usage() {
  printf '%s\n' "Usage: script/bootstrap [--apply]"
}

apply=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --apply) apply=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

if [ "$apply" = true ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
  printf '%s\n' "Refusing to modify a non-interactive session." >&2
  exit 1
fi

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)
source_dir="$repo_root/home"

if [ ! -d "$source_dir" ] || [ ! -f "$source_dir/dot_bashrc" ]; then
  printf '%s\n' "Invalid Chezmoi source directory: $source_dir" >&2
  exit 1
fi

os=$(uname -s)
arch=$(uname -m)

case "$os:$arch" in
  Darwin:arm64|Darwin:x86_64) platform=macos ;;
  Linux:*)
    if [ ! -e /etc/arch-release ]; then
      printf '%s\n' "Unsupported Linux distribution. Only Arch Linux is supported." >&2
      exit 1
    fi
    platform=arch
    ;;
  *)
    printf '%s\n' "Unsupported platform: $os $arch" >&2
    exit 1
    ;;
esac

if [ "$apply" = false ]; then
  printf '%s\n' "Platform: $platform ($arch)"
  printf '%s\n' "Would install the base package set and initialize Chezmoi from: $source_dir"
  printf '%s\n' "Run script/bootstrap --apply from an interactive terminal to continue."
  exit 0
fi

if [ "$platform" = macos ]; then
  brew_bin=$(command -v brew || true)
  if [ -z "$brew_bin" ]; then
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
      if [ -x "$candidate" ]; then
        brew_bin=$candidate
        break
      fi
    done
  fi

  if [ -z "$brew_bin" ]; then
    printf '%s\n' "Homebrew is required. Install Xcode Command Line Tools and Homebrew, then rerun this command." >&2
    exit 1
  fi

  "$brew_bin" bundle check --file "$repo_root/Brewfile.base" >/dev/null 2>&1 || \
    "$brew_bin" bundle install --file "$repo_root/Brewfile.base" --no-upgrade
else
  if ! command -v sudo >/dev/null 2>&1 || ! command -v pacman >/dev/null 2>&1; then
    printf '%s\n' "Arch bootstrap requires sudo and pacman." >&2
    exit 1
  fi
  printf '%s\n' "Arch packages will update the complete system before installing the base profile."
  set --
  while IFS= read -r package; do
    [ -n "$package" ] && set -- "$@" "$package"
  done < "$repo_root/packages/arch/base.txt"
  sudo pacman -Syu --needed "$@"
fi

for command in chezmoi mise fish; do
  if ! command -v "$command" >/dev/null 2>&1; then
    printf '%s\n' "Required command is unavailable after installation: $command" >&2
    exit 1
  fi
done

chezmoi init --source "$source_dir"

if chezmoi diff; then
  :
else
  diff_status=$?
  if [ "$diff_status" -ne 1 ]; then
    exit "$diff_status"
  fi
fi

if [ "$apply" = true ]; then
  printf '%s' "Apply the displayed Chezmoi changes? [y/N] "
  read -r answer
  case "$answer" in
    y|Y|yes|YES) ;;
    *) printf '%s\n' "No files were applied."; exit 0 ;;
  esac
fi

chezmoi apply
mise install
mise reshim
mise doctor || printf '%s\n' "mise doctor reported diagnostics; run script/verify for details." >&2

printf '%s\n' "Base setup completed. Run script/profile list to view optional profiles."
