#!/bin/sh

set -eu

usage() {
  printf '%s\n' "Usage: pokemonsay [--list] [--cowfile NAME.cow] [--] [message]"
}

script_path=$0
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case "$link" in
    /*) script_path=$link ;;
    *) script_path=$(dirname "$script_path")/$link ;;
  esac
done
script_dir=$(CDPATH='' cd -- "$(dirname "$script_path")" && pwd -P)
cow_dir="$script_dir/pokemons"
[ -d "$cow_dir" ] && [ ! -L "$cow_dir" ] || { printf '%s\n' "Pokemon payload is unavailable." >&2; exit 1; }

list=false
cow_file=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --list) list=true; shift ;;
    -f|--cowfile)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      cow_file=$2
      shift 2
      ;;
    --) shift; break ;;
    -*) usage >&2; exit 2 ;;
    *) break ;;
  esac
done

if [ "$list" = true ]; then
  [ -z "$cow_file" ] && [ "$#" -eq 0 ] || { usage >&2; exit 2; }
  LC_ALL=C find "$cow_dir" -type f ! -type l -name '*.cow' -exec basename {} \; | LC_ALL=C sort
  exit 0
fi

if [ -n "$cow_file" ]; then
  case "$cow_file" in
    *[!A-Za-z0-9._-]*|.*|*..*) printf '%s\n' "Invalid cowfile." >&2; exit 2 ;;
    *.cow) ;;
    *) printf '%s\n' "Cowfile must end in .cow." >&2; exit 2 ;;
  esac
  cow_path="$cow_dir/$cow_file"
  [ -f "$cow_path" ] && [ ! -L "$cow_path" ] || { printf '%s\n' "Cowfile is unavailable." >&2; exit 1; }
else
  cow_path=$(LC_ALL=C find "$cow_dir" -type f ! -type l -name '*.cow' -print | LC_ALL=C awk 'BEGIN { srand() } { if (rand() < 1 / NR) selected = $0 } END { print selected }')
  [ -n "$cow_path" ] || { printf '%s\n' "No cowfiles are available." >&2; exit 1; }
fi

cowsay=$(command -v cowsay) || { printf '%s\n' "cowsay is required." >&2; exit 1; }
if [ "$#" -gt 0 ]; then
  "$cowsay" -f "$cow_path" "$*"
else
  "$cowsay" -f "$cow_path"
fi
