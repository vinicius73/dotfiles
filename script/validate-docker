#!/bin/sh

set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
image=dotfiles-arch-validation
platform=linux/amd64

command -v docker >/dev/null 2>&1 || {
  printf '%s\n' "Docker is required." >&2
  exit 1
}
docker info >/dev/null 2>&1 || {
  printf '%s\n' "Docker daemon is unavailable. Start Docker and retry." >&2
  exit 1
}

docker build --platform "$platform" --tag "$image" "$repo_root/docker/arch-validation"
docker run --platform "$platform" --rm --read-only --tmpfs /tmp:rw,exec,nosuid,size=128m --mount "type=bind,src=$repo_root,dst=/workspace,readonly" "$image"
