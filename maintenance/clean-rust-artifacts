#!/bin/sh

set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
# shellcheck source=maintenance/lib/common.sh
. "$script_dir/lib/common.sh"

usage() {
  printf '%s\n' "Usage: maintenance/clean-rust-artifacts plan|apply --root DIRECTORY"
}

mode=${1:-}
shift || true
root=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --root) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; root=$2; shift 2 ;;
    *) usage >&2; exit 2 ;;
  esac
done
case "$mode" in plan|apply) ;; *) usage >&2; exit 2 ;; esac
root=$(maintenance_validate_root "$root") || exit "$?"

manifests=$(find "$root" \( -type d \( -name .git -o -name node_modules -o -name target \) -prune \) -o \( -type f -name Cargo.toml -print \))
[ -n "$manifests" ] && printf '%s\n' "$manifests" || printf '%s\n' "No Cargo manifests found."
[ "$mode" = plan ] && exit 0
command -v cargo >/dev/null 2>&1 || { printf '%s\n' "cargo is required." >&2; exit 1; }
maintenance_confirm_apply "Type APPLY to run cargo clean for the listed manifests: " || exit "$?"

clean_manifest() {
  cargo clean --manifest-path "$1"
}

maintenance_run_targets "$manifests" clean_manifest
