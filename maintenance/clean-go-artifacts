#!/bin/sh

set -eu

usage() {
  printf '%s\n' "Usage: maintenance/clean-go-artifacts plan|apply --root DIRECTORY"
}

mode=${1:-}
shift || true
root=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --root) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; root=$2; shift 2 ;;
    *) usage >&2; exit 2 ;;
  esac
done
case "$mode" in plan|apply) ;; *) usage >&2; exit 2 ;; esac
case "$root" in /*) ;; *) printf '%s\n' "Root must be an absolute path." >&2; exit 2 ;; esac
[ -d "$root" ] && [ ! -L "$root" ] || { printf '%s\n' "Root must be a physical directory." >&2; exit 1; }
root=$(CDPATH='' cd -- "$root" && pwd -P)
case "$root" in /|"$HOME") printf '%s\n' "Refusing unsafe root: $root" >&2; exit 1 ;; esac

targets=$(find "$root" \( -type d \( -name .git -o -name node_modules -o -name target \) -prune \) -o \( -type f -name go.mod -exec dirname {} \; \))
targets=$(printf '%s\n' "$targets" | while IFS= read -r project; do [ -d "$project/bin" ] && [ ! -L "$project/bin" ] && printf '%s\n' "$project/bin"; done)
[ -n "$targets" ] && printf '%s\n' "$targets" || printf '%s\n' "No Go artifacts found."
[ "$mode" = plan ] && exit 0
[ -t 0 ] && [ -t 1 ] || { printf '%s\n' "Apply requires an interactive terminal." >&2; exit 1; }
printf '%s' "Type APPLY to remove the listed Go artifacts: "
IFS= read -r answer < /dev/tty || exit 1
[ "$answer" = APPLY ] || { printf '%s\n' "Operation cancelled." >&2; exit 1; }
printf '%s\n' "$targets" | while IFS= read -r target; do [ -z "$target" ] || rm -rf "$target"; done
