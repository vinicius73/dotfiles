#!/bin/sh

set -eu

usage() {
  printf '%s\n' "Usage: maintenance/audit-js-vulnerabilities audit|fix --root DIRECTORY [--severity LEVEL]"
}

mode=${1:-}
shift || true
root=
severity=moderate
while [ "$#" -gt 0 ]; do
  case "$1" in
    --root) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; root=$2; shift 2 ;;
    --severity)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      severity=$2
      case "$severity" in low|moderate|high|critical) ;; *) printf '%s\n' "Invalid severity: $severity" >&2; exit 2 ;; esac
      shift 2
      ;;
    *) usage >&2; exit 2 ;;
  esac
done
case "$mode" in audit|fix) ;; *) usage >&2; exit 2 ;; esac
case "$root" in /*) ;; *) printf '%s\n' "Root must be an absolute path." >&2; exit 2 ;; esac
[ -d "$root" ] && [ ! -L "$root" ] || { printf '%s\n' "Root must be a physical directory." >&2; exit 1; }
root=$(CDPATH='' cd -- "$root" && pwd -P)
case "$root" in /|"$HOME") printf '%s\n' "Refusing unsafe root: $root" >&2; exit 1 ;; esac

projects=$(find "$root" \( -type d \( -name .git -o -name node_modules \) -prune \) -o \( -type f -name package.json -exec dirname {} \; \))
[ -n "$projects" ] && printf '%s\n' "$projects" || printf '%s\n' "No JavaScript projects found."
[ "$mode" = audit ] || {
  [ -t 0 ] && [ -t 1 ] || { printf '%s\n' "Fix requires an interactive terminal." >&2; exit 1; }
  printf '%s' "Type APPLY to run package-manager fixes in the listed projects: "
  IFS= read -r answer < /dev/tty || exit 1
  [ "$answer" = APPLY ] || { printf '%s\n' "Operation cancelled." >&2; exit 1; }
}

status=0
while IFS= read -r project; do
  [ -n "$project" ] || continue
  if [ -f "$project/pnpm-lock.yaml" ]; then manager=pnpm
  elif [ -f "$project/bun.lockb" ] || [ -f "$project/bun.lock" ]; then manager=bun
  elif [ -f "$project/yarn.lock" ]; then manager=yarn
  elif [ -f "$project/package-lock.json" ]; then manager=npm
  else manager=npm
  fi
  command -v "$manager" >/dev/null 2>&1 || { printf '%s\n' "Skipping $project: $manager is unavailable." >&2; status=1; continue; }
  if [ "$mode" = audit ]; then
    (cd "$project" && "$manager" audit --json --audit-level="$severity") || status=1
  else
    (cd "$project" && "$manager" audit fix --audit-level="$severity") || status=1
  fi
done <<EOF
$projects
EOF
exit "$status"
